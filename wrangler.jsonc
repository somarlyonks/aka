{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "aka",
    "main": "src/index.ts",
    "compatibility_date": "2026-01-01",
    "observability": {
        "enabled": false
    },
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": [
            "/",
            "/_templates/*"
        ]
    },
    "triggers": {
        "crons": [
            "0 3 * * *"
        ]
    },
    "ratelimits": [
        {
            "name": "RATE_LIMITER",
            "namespace_id": "1001",
            "simple": {
                "limit": 60,
                "period": 60
            }
        }
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "aka",
            "database_id": "00000000000000000000000000000000",
            "migrations_dir": "src/db/migrations"
        }
    ],
    "env": {
        "prod": {
            "name": "aka",
            "workers_dev": false,
            "preview_urls": false,
            "routes": [
                {
                    "pattern": "aka.somarl.com",
                    "custom_domain": true
                }
            ],
            "ratelimits": [
                {
                    "name": "RATE_LIMITER",
                    "namespace_id": "1001",
                    "simple": {
                        "limit": 60,
                        "period": 60
                    }
                }
            ],
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "aka",
                    "database_id": "8097ecb9-a486-4a4e-8a4d-b875c3f0f5f7",
                    "migrations_dir": "src/db/migrations"
                }
            ]
        }
    }
}
