{
    "name": "aka",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "wrangler dev",
        "deploy": "wrangler deploy --env prod",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "db:migrate:local": "wrangler d1 migrations apply aka --local",
        "db:migrate:prod": "wrangler d1 migrations apply aka --remote --env prod",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "hono": "^4.13.14"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "^1.4.12",
        "@cloudflare/workers-types": "^5.20261026.1",
        "@playwright/test": "^1.64.1",
        "@somarlyonks/eslint": "^1",
        "eslint": "^10",
        "typescript": "^5.9.3",
        "vitest": "^4.1.12",
        "wrangler": "^4.152.0"
    }
}
